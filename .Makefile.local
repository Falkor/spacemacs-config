# -*- mode: makefile; -*-
# Complementary local Makefile rules in complement to the default one in the root Makefile .

UNAME := $(shell uname)

# Where to install spacemacs
EMACS_CONFIG_DIR   = $(HOME)/.config/emacs.spacemacs.d
# Where to install the present spacemacs configuration
USER_SPACEMACS_DIR = $(HOME)/.config/spacemacs.falkor.d

SETUP_TARGETS += install-packages install-fonts install-spacemacs install-spacemacs-config
CLEAN_TARGETS += clean-elc-settings
INFO_TARGETS  += info-emacs

EMACS             = emacs
EMACS_BATCH       = $(EMACS) -Q -batch -f batch-byte-compile
DIRS              = settings
SETTINGS_SOURCES  = $(shell find settings   -name '*.el')
SETTINGS_TARGETS  = $(patsubst %.el,%.elc, $(SETTINGS_SOURCES))

### List of complementary system packages to install
# Mac OS X with Homebrew
define Darvin_PACKAGE_LIST
	aspell
  black
  cmake
	cscope
  dash5
	fd
	findutils
  flake8
  git-delta
  gopls
  ipython
  libvterm
  luarocks
  prettier
	ripgrep
  rtags
  shellcheck
	solargraph
  solidity
  sqlite3
endef

# Windows with chocolatey
define Windows_PACKAGE_LIST
# TODO
endef

# Common Linux package
define Linux_PACKAGE_LIST
	aspell
	black
	ccls
	cmake
	cscope
	dash
	fontconfig
	emacs
	emacs-libvterm
	fd-find
	flake8
	gopls
	ipython3
	lldb
	locate
	luarocks
	rtags
	shellcheck
	silversearcher-ag
	python3-bashate
endef
# Specific Debian packages
define Debian_PACKAGE_LIST
	fonts-powerline
	fonts-font-awesome
endef
# Specific Redhat packages
define Redhat_PACKAGE_LIST
	fontawesome-fonts-all
endef

define NPM_PACKAGE_LIST
  bash-language-server
	intelephense
  vmd
endef

### General information
info-emacs:
	@echo "EMACS            = $(EMACS)"
	@echo "EMACS_BATCH      = $(EMACS_BATCH)"
	@echo "DIRS             = $(DIRS)"
	@echo "SETTINGS_SOURCES = $(SETTINGS_SOURCES)"
	@echo "SETTINGS_TARGETS = $(SETTINGS_TARGETS)"
	@echo
	@echo "Darvin_PACKAGE_LIST  = $(shell echo $(Darvin_PACKAGE_LIST))"
	@echo "Windows_PACKAGE_LIST = $(shell echo $(Windows_PACKAGE_LIST))"
	@echo "Linux_PACKAGE_LIST   = $(shell echo $(Linux_PACKAGE_LIST))"
	@echo "Debian_PACKAGE_LIST  = $(shell echo $(Debian_PACKAGE_LIST))"
	@echo "Redhat_PACKAGE_LIST  = $(shell echo $(Debian_PACKAGE_LIST))"

################### Emacs install #####################
install-emacs: install-emacs-$(shell echo $(UNAME) | tr A-Z a-z)
install-emacs-darwin: install-emacs-darwin-mac-plus
install-emacs-linux:
	@if [ -f '/etc/os-release' ]; then \
		$(MAKE) install-emacs-linux-$(shell grep '^ID=' /etc/os-release | cut -d= -f 2); \
	else \
		echo "check (or implement) for appropriate 'make  install-emacs-linux-[...]"; \
	fi


# Linux
install-emacs-linux-debian install-emacs-linux-ubuntu install-emacs-linux-kali:
	sudo apt install emacs
install-emacs-linux-redhat:
	sudo dnf install emacs


### Mac OS with homebrew
install-emacs-darwin-mac-plus:
	brew tap d12frosted/emacs-plus
	brew install emacs-plus --with-spacemacs-icon
	brew linkapps emacs-plus
install-emacs-darwin-macport:
	brew tap railwaycat/emacsmacport
	brew install --cask emacs-mac-spacemacs-icon


################### Fonts #####################
install-fonts: install-fonts-$(shell echo $(UNAME) | tr A-Z a-z)

install-fonts-darwin:
	brew tap homebrew/cask-fonts
	brew install --cask font-source-code-pro font-meslo-lg-nerd-font

install-fonts-linux-debian install-fonts-linux-ubuntu install-fonts-linux-kali:
	sudo apt install fonts-powerline fonts-font-awesome fonts-anonymous-pro fonts-anonymous-pro fonts-noto-color-emoji

install-fonts-linux-redhat:
	sudo dnf install fontawesome-fonts-all

install-fonts-linux:
	@if [ -f '/etc/os-release' ]; then \
		$(MAKE) install-fonts-linux-$(shell grep '^ID=' /etc/os-release | cut -d= -f 2); \
	else \
		echo "check (or implement) for appropriate 'make  install-fonts-linux-[...]"; \
	fi
	@echo "=> Install nerd fonts using (for instance) the 'font-install' script (copy/paste the below commands)"
	@echo "wget -nv -P /tmp https://gitlab.com/svarrette-anssi/tutorial-git/-/raw/main/scripts/font-install"
	@echo "less /tmp/font-install"
	@echo "/tmp/font-install     # dry-run"
	@echo "/tmp/font-install  -x"


################### Spacemacs install #####################
install-spacemacs: setup-xdg
	@if [ -d "$(EMACS_CONFIG_DIR)" ]; then \
		echo "=> pulling latest commits into '$(EMACS_CONFIG_DIR)'"; \
		git -C $(EMACS_CONFIG_DIR) pull origin; \
	else \
		git clone https://github.com/syl20bnr/spacemacs $(EMACS_CONFIG_DIR); \
	fi
	@if [ ! -e "$(HOME)/.config/emacs" ]; then \
		ln -s $(EMACS_CONFIG_DIR) ~/.config/emacs; \
	fi

install-spacemacs-config:
	@if [ -d "$(USER_SPACEMACS_DIR)" ]; then \
		echo "=> pulling latest commits into '$(USER_SPACEMACS_DIR)'"; \
		git -C $(USER_SPACEMACS_DIR) pull origin; \
	else \
		git clone https://github.com/Falkor/spacemacs-config.git $(USER_SPACEMACS_DIR); \
	fi
	@if [ ! -e "$(HOME)/.config/spacemacs" ]; then \
		ln -s $(USER_SPACEMACS_DIR) ~/.config/spacemacs; \
	fi


################### Package install #####################
install-packages: install-packages-$(shell echo $(UNAME) | tr A-Z a-z)

install-packages-darwin: install-fonts-darwin
	brew install $(shell   echo $(Linux_PACKAGE_LIST))
	npm install -g $(shell echo $(NPM_PACKAGE_LIST))

install-packages-windows:
	@echo "You MUST define properly Windows_PACKAGE_LIST in .Makefile.local"
	@echo "choco install   $(shell   echo $(Windows_PACKAGE_LIST))"

install-packages-linux:
	@if [ -f '/etc/os-release' ]; then \
		$(MAKE) install-packages-linux-$(shell grep '^ID=' /etc/os-release | cut -d= -f 2); \
	else \
		echo "check (or implement) for appropriate 'make  install-package-linux-[...]"; \
	fi

install-packages-linux-debian install-packages-linux-ubuntu install-packages-linux-kali:
	@echo "=> installing packages for Debian-like distributions"
	sudo apt install $(shell echo $(Linux_PACKAGE_LIST) $(Debian_PACKAGE_LIST))

install-packages-linux-redhat:
	@echo "=> installing packages for Redhat-like distributions"
	sudo dnf install $(shell echo $(Linux_PACKAGE_LIST) $(Redhat_PACKAGE_LIST))


# https://github.com/Alloyed/lua-lsp
setup-lua:
	luarocks install luacheck


### Byte compilation
compile:  $(patsubst %,compile-%, $(DIRS))
compile-settings: $(SETTINGS_TARGETS)

%.elc: %.el
	@echo $(EMACS_BATCH) $<

clean-elc-settings:
	rm -rf $(SETTINGS_TARGETS)
